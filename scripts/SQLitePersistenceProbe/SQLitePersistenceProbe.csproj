<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <Target Name="RequirePersistenceRuntime" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(PersistenceRuntimePath)/RMC.BestFit.UI.dll')" Text="Pass PersistenceRuntimePath pointing to a previously built BestFit UI runtime." />
  </Target>
</Project>
