    <!-- Rating Curve Analysis Icon - Power-law curve with uncertainty band (16x16) -->
    <!-- L-shaped axes (foreground) + uncertainty envelope (document fill) + central curve (accent) -->
    <!-- Rating curve: stage(y) vs discharge(x), steep rise that flattens — classic Q = α(h-ξ)^β  -->
    <DrawingImage x:Key="RatingCurveAnalysisIcon" x:Shared="False" po:Freeze="False">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.Children>
                    <!-- Transparent background -->
                    <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M16,16L0,16 0,0 16,0z" />
                    <!-- L-shaped axes: left vertical (1x16) + bottom horizontal (15x1) (foreground) -->
                    <GeometryDrawing Brush="{DynamicResource ToolbarIconForeground}" Geometry="F1M0,0L1,0 1,15 16,15 16,16 0,16z" />
                    <!-- Uncertainty envelope: semi-transparent accent blue band               -->
                    <GeometryDrawing Brush="#601C97EA">
                        <GeometryDrawing.Geometry>
                            <PathGeometry>
                                <PathFigure StartPoint="2,14" IsClosed="True" IsFilled="True">
                                    <!-- Upper bound -->
                                    <QuadraticBezierSegment Point1="2,6" Point2="5,4" />
                                    <QuadraticBezierSegment Point1="8,2" Point2="15,1" />
                                    <!-- Cap across top -->
                                    <LineSegment Point="15,4" />
                                    <!-- Lower bound (tighter to central curve) -->
                                    <QuadraticBezierSegment Point1="8,5" Point2="6,7" />
                                    <QuadraticBezierSegment Point1="4,10" Point2="4,14" />
                                </PathFigure>
                            </PathGeometry>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <!-- Central rating curve: 2px thick accent blue over the envelope -->
                    <GeometryDrawing Brush="{DynamicResource ToolbarIconAccent}">
                        <GeometryDrawing.Geometry>
                            <PathGeometry>
                                <PathFigure StartPoint="2,14" IsClosed="True" IsFilled="True">
                                    <!-- Top edge -->
                                    <QuadraticBezierSegment Point1="2,7" Point2="5,5" />
                                    <QuadraticBezierSegment Point1="8,3" Point2="15,2" />
                                    <!-- Right cap down 2px -->
                                    <LineSegment Point="15,4" />
                                    <!-- Bottom edge -->
                                    <QuadraticBezierSegment Point1="8,5" Point2="5,7" />
                                    <QuadraticBezierSegment Point1="3,9" Point2="3,14" />
                                </PathFigure>
                            </PathGeometry>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup.Children>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

