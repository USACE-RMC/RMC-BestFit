    <DrawingImage x:Key="MixtureAnalysisIcon" x:Shared="False" po:Freeze="False">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.Children>
                    <!-- Transparent background -->
                    <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M16,16L0,16 0,0 16,0z" />
                    <!-- Knockout (transparent) -->
                    <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M4.7637,-0.000199999999999534L-0.000300000000000189,2.3818 -0.000300000000000189,3.6178 1.9997,4.6188 1.9997,13.6188 6.7637,15.9998 7.9997,15.9998 7.9997,13.6188 15.9997,9.6178 15.9997,2.8818 13.4997,4.1318 5.2367,-0.000199999999999534z" />
                    <!-- Top face (foreground) -->
                    <GeometryDrawing Brush="{DynamicResource ToolbarIconForeground}" Geometry="F1M12,4.5L5,1 1,3 8,6.5z" />
                    <!-- Left face (foreground) -->
                    <GeometryDrawing Brush="{DynamicResource ToolbarIconForeground}" Geometry="F1M3,13L7,15 7,7.35 3,5.5z" />
