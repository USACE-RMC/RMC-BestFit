    <!-- Distribution Fitting Analysis Icon - Histogram with fitted curve (16x16) -->
    <!-- Layout: L-shaped axes (1px) + 3 histogram bars (3px wide, 1px spacing) + blue curve -->
    <!-- Left axis:   x=0, full height 16px, 1px wide                                       -->
    <!-- Bottom axis: y=15, starts at x=1, 15px wide, 1px tall, connects at corner           -->
    <!-- Bar 1: x=2  w=3 h=4  (y=11..15)                                                    -->
    <!-- Bar 2: x=6  w=3 h=14 (y=1..15)                                                     -->
    <!-- Bar 3: x=10 w=3 h=11 (y=4..15)                                                     -->
    <DrawingImage x:Key="FittingAnalysisIcon" x:Shared="False" po:Freeze="False">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.Children>
                    <!-- Transparent background -->
                    <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M16,16L0,16 0,0 16,0z" />
                    <!-- L-shaped axes: left vertical (1x16) + bottom horizontal (15x1) (foreground) -->
                    <GeometryDrawing Brush="{DynamicResource ToolbarIconForeground}" Geometry="F1M0,0L1,0 1,15 16,15 16,16 0,16z" />
                    <!-- Histogram bars: 3 bars, 3px wide, 1px gaps (foreground) -->
                    <GeometryDrawing Brush="{DynamicResource ToolbarIconForeground}" Geometry="F1M2,11L5,11 5,15 2,15z M6,1L9,1 9,15 6,15z M10,4L13,4 13,15 10,15z" />
                    <!-- Fitted curve: 3px thick filled shape, start (3,10) apex (8,4) end (15,11) -->
                    <!-- Top edge curves from (3,10) through apex (8,4) to (15,11)                -->
                    <!-- Bottom edge curves back from (15,14) through (8,7) to (3,13)             -->
                    <GeometryDrawing Brush="#FF00CED1">
                        <GeometryDrawing.Geometry>
                            <PathGeometry>
                                <PathFigure StartPoint="3,10" IsClosed="True" IsFilled="True">
                                    <!-- Top edge: left to right -->
                                    <QuadraticBezierSegment Point1="5.5,2" Point2="8,4" />
                                    <QuadraticBezierSegment Point1="10.5,6" Point2="15,11" />
                                    <!-- Right cap down 3px -->
                                    <LineSegment Point="15,14" />
                                    <!-- Bottom edge: right to left (wider gap on steep left side) -->
                                    <QuadraticBezierSegment Point1="10.5,9" Point2="8,7" />
                                    <QuadraticBezierSegment Point1="5.5,6" Point2="3,14" />
                                </PathFigure>
                            </PathGeometry>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup.Children>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Bivariate Analysis Icon - Scatter plot with copula pattern (16x16) -->
    <!-- L-shaped axes (foreground) + 8 data points 2x2px (accent) in upward copula shape -->
    <DrawingImage x:Key="BivariateAnalysisIcon" x:Shared="False" po:Freeze="False">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.Children>
                    <!-- Transparent background -->
                    <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M16,16L0,16 0,0 16,0z" />
                    <!-- L-shaped axes: left vertical (1x16) + bottom horizontal (15x1) (foreground) -->
                    <GeometryDrawing Brush="{DynamicResource ToolbarIconForeground}" Geometry="F1M0,0L1,0 1,15 16,15 16,16 0,16z" />
                    <!-- 13 data points 2x2px in Gumbel copula pattern (accent)              -->
                    <!-- Lower-left: wide scatter around 1:1. Upper-right: tight on 1:1  -->
                    <!-- Upper tail dependence: cluster tightens toward upper-right corner -->
                    <!-- Coords given as bottom-left of 2x2 square; XAML rect = (x, y-2, 2, 2) -->
                    <GeometryDrawing Brush="{DynamicResource ToolbarIconAccent}" Geometry="F1M3,12L5,12 5,14 3,14z M3,9L5,9 5,11 3,11z M6,12L8,12 8,14 6,14z M6,9L8,9 8,11 6,11z M4,6L6,6 6,8 4,8z M9,12L11,12 11,14 9,14z M9,9L11,9 11,11 9,11z M12,9L14,9 14,11 12,11z M10,6L12,6 12,8 10,8z M7,6L9,6 9,8 7,8z M10,3L12,3 12,5 10,5z M14,2L16,2 16,4 14,4z M13,5L15,5 15,7 13,7z" />
                </DrawingGroup.Children>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

