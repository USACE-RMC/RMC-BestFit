        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Univariate Analysis Icon - Two overlapping bell curves matching app icon (16x16)       -->
    <!-- Right/larger bell = pink/magenta (posterior), Left/smaller bell = blue (prior)         -->
    <!-- Replicates the BestFit application icon concept: prior -> posterior Bayesian updating  -->
    <DrawingImage x:Key="UnivariateAnalysisIcon" x:Shared="False" po:Freeze="False">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.Children>
                    <!-- Transparent background -->
                    <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M16,16L0,16 0,0 16,0z" />
                    <!-- L-shaped axes: left vertical (1x16) + bottom horizontal (15x1) (foreground) -->
                    <GeometryDrawing Brush="{DynamicResource ToolbarIconForeground}" Geometry="F1M0,0L1,0 1,15 16,15 16,16 0,16z" />
                    <!-- Right/larger bell curve (posterior) - pink/magenta, above bottom axis -->
                    <GeometryDrawing Brush="#D64D8A">
                        <GeometryDrawing.Geometry>
                            <PathGeometry>
                                <PathFigure StartPoint="5,15" IsClosed="True" IsFilled="True">
                                    <!-- Left base to inflection (~y=11): concave up (short flare) -->
                                    <BezierSegment Point1="5,13.5" Point2="5.5,11" Point3="6,11" />
                                    <!-- Left inflection to peak: concave down (wide dome) -->
                                    <BezierSegment Point1="6.5,11" Point2="6.5,1.5" Point3="8.5,1.5" />
                                    <!-- Peak to right inflection: concave down (wide dome) -->
                                    <BezierSegment Point1="10.5,1.5" Point2="10.5,11" Point3="11,11" />
                                    <!-- Right inflection to base (~y=11): concave up (short flare) -->
                                    <BezierSegment Point1="11.5,11" Point2="13,13.5" Point3="14.5,15" />
                                </PathFigure>
                            </PathGeometry>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <!-- Left/smaller bell curve (prior) - blue/purple, above bottom axis -->
                    <GeometryDrawing Brush="#5B6BDE">
                        <GeometryDrawing.Geometry>
                            <PathGeometry>
                                <PathFigure StartPoint="1,15" IsClosed="True" IsFilled="True">
                                    <BezierSegment Point1="1.5,9" Point2="2.5,6" Point3="3.5,6" />
                                    <BezierSegment Point1="4.5,6" Point2="5.5,11" Point3="6.5,15" />
                                </PathFigure>
                            </PathGeometry>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup.Children>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Bulletin 17C Analysis Icon - "B17" text in Segoe UI SemiBold 10pt (16x16) -->
