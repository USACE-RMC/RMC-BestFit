    <!-- Time Series Analysis Icon - Zig-zag line plot with clock (16x16) -->
    <!-- L-shaped axes (foreground) + blue zig-zag line + small clock bottom-right -->
    <!-- Clock: center (12,11), outer r=3 (9→15 x, 8→14 y), hands L-shape          -->
    <DrawingImage x:Key="TimeSeriesAnalysisIcon" x:Shared="False" po:Freeze="False">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.Children>
                    <!-- Transparent background -->
                    <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M16,16L0,16 0,0 16,0z" />
                    <!-- L-shaped axes: left vertical (1x16) + bottom horizontal (15x1) (foreground) -->
                    <GeometryDrawing Brush="{DynamicResource ToolbarIconForeground}" Geometry="F1M0,0L1,0 1,15 16,15 16,16 0,16z" />
                    <!-- Zig-zag time series line: 2px thick filled shape (accent blue) -->
                    <!-- Points: (2,10) (4,4) (6,8) (8,2) (10,6) (14,3) -->
                    <GeometryDrawing Brush="{DynamicResource ToolbarIconAccent}">
                        <GeometryDrawing.Geometry>
                            <PathGeometry>
                                <PathFigure StartPoint="2,10" IsClosed="True" IsFilled="True">
                                    <!-- Top edge -->
                                    <LineSegment Point="4,4" />
                                    <LineSegment Point="6,8" />
                                    <LineSegment Point="8,2" />
                                    <LineSegment Point="10,6" />
                                    <LineSegment Point="14,3" />
                                    <!-- Right cap down 2px -->
                                    <LineSegment Point="14,5" />
                                    <!-- Bottom edge -->
                                    <LineSegment Point="10,8" />
                                    <LineSegment Point="8,4" />
                                    <LineSegment Point="6,10" />
                                    <LineSegment Point="4,6" />
                                    <LineSegment Point="2,12" />
                                </PathFigure>
                            </PathGeometry>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <!-- Clock outline circle + hands (foreground) -->
                    <!-- Outer ring: center (12,11), r=3. Hands: vertical up 2px, horizontal right 2px -->
                    <GeometryDrawing Brush="{DynamicResource ToolbarIconForeground}" Geometry="F1M14,11L14,12 12,12 12,9 13,9 13,11z M12,14C10.345,14 9,12.655 9,11 9,9.345 10.345,8 12,8 13.655,8 15,9.345 15,11 15,12.655 13.655,14 12,14 M12,7C9.791,7 8,8.791 8,11 8,13.209 9.791,15 12,15 14.209,15 16,13.209 16,11 16,8.791 14.209,7 12,7" />
                    <!-- Clock face (document fill) -->
                    <GeometryDrawing Brush="{DynamicResource ToolbarIconDocumentFill}" Geometry="F1M14,12L12,12 12,9 13,9 13,11 14,11z M12,8C10.345,8 9,9.345 9,11 9,12.655 10.345,14 12,14 13.655,14 15,12.655 15,11 15,9.345 13.655,8 12,8" />
                </DrawingGroup.Children>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

