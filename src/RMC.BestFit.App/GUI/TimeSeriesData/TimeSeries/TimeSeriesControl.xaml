<UserControl x:Class="RMC_BestFit.TimeSeriesControl" x:Name="TSControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:RMC_BestFit"
             xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
             xmlns:nCntrls="clr-namespace:NumericControls;assembly=NumericControls"
             xmlns:oxyCntrls="clr-namespace:OxyPlotControls;assembly=OxyPlotControls"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             PreviewMouseDown="Control_PreviewMouseDown"
             LostFocus="Control_LostFocus"
             Background="{DynamicResource EnvironmentWindowBackground}"
             Foreground="{DynamicResource EnvironmentWindowText}"
>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <cntrls:DoubleToNAConverter x:Key="NAConverter"/>
                    <cntrls:ReverseBooleanConverter x:Key="ReverseBoolConverter"/>
                    <cntrls:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <TabControl x:Name="MainTabControl" TabStripPlacement="Left" SelectionChanged="MainTabControl_SelectionChanged">
        <!-- Data Tab -->
        <TabItem x:Name="DataTab" Header="Time Series" Style="{DynamicResource VerticalTabItemStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" MinWidth="100" MaxWidth="600"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <TabControl x:Name="DataTabControl" TabStripPlacement="Top" Grid.Column="0" Margin="2, 2, 0, 2" >
                    <TabItem Header="Time Series Data" Style="{DynamicResource HorizontalTabItemStyle}" >
                        <nCntrls:TimeSeriesTable x:Name="TimeSeriesTable"
                            XColumnHeader="Date Time"
                            YColumnHeader="Value"
                            Series="{Binding Element.TimeSeries, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                        </nCntrls:TimeSeriesTable>
                    </TabItem>
                    <TabItem Header="Summary Statistics" Style="{DynamicResource HorizontalTabItemStyle}">
                        <Grid Margin="4,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <cntrls:CopyPasteDataGrid Name="SummaryStatisticsDataGrid" HeadersVisibility="Column" Style="{DynamicResource CopyPasteDataGridStyle}"
                                                AutoGenerateColumns="False"
                                                SelectionMode="Extended" SelectionUnit="Cell" IsReadOnly="True"
                                                CanUserDeleteRows="False" CanUserAddRows="False" CanUserResizeColumns="True" ShowSortContextMenu="False"
                                                CanUserResizeRows="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                                                LoadingRow="SummaryStatisticsDataGrid_LoadingRow">
                                <cntrls:CopyPasteDataGrid.Columns>
                                    <DataGridTextColumn x:Name="StatNameColumn" Header="Measure" IsReadOnly="True" MinWidth="50" Width="0.5*"
                                                        Binding="{Binding Path=Name}"
                                                        HeaderStyle="{DynamicResource Left_ColumnHeaderStyle}"
                                                        CellStyle="{DynamicResource Left_CellStyle}"/>
                                    <DataGridTextColumn x:Name="SystematicDataValueColumn" Header="Value" IsReadOnly="True"  MinWidth="50" Width="0.5*"
                                                        Binding="{Binding Path=Value, StringFormat={}{0:#,##0.####}, FallbackValue=N/A, TargetNullValue=N/A, Converter={StaticResource NAConverter}}"
                                                        HeaderStyle="{DynamicResource Center_ColumnHeaderStyle}"
                                                        CellStyle="{DynamicResource Right_CellStyle}"/>
                                </cntrls:CopyPasteDataGrid.Columns>
                            </cntrls:CopyPasteDataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>

                <GridSplitter Grid.Column="1" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Transparent" Style="{DynamicResource VerticalGridSplitterStyle}"/>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!--Alternative Time Series Toggle-->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="5,0,0,0"
                                Height="22" VerticalAlignment="Center" HorizontalAlignment="Left"
                                ToolTip="Show options for viewing alternative time series.">
                        <ToggleButton x:Name="ShowAlternativesToggleButton"
                                      SnapsToDevicePixels="True"
                                      VerticalAlignment="Center" HorizontalAlignment="Left"
                                      IsChecked="False"
                                      Style="{DynamicResource PlusMinusToggleStyle}"/>
                        <TextBlock Text="Alternative Time Series" VerticalAlignment="Center"
                                   Margin="2,0,0,0"
                                   Foreground="{DynamicResource EnvironmentWindowText}"
                                   MouseLeftButtonUp="AlternativesTextBlock_MouseLeftButtonUp"/>
                    </StackPanel>

                    <!--Alternatives Panel + Plot + Toolbar-->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!--Collapsible Alternatives Panel-->
                        <local:AlternativeTimeSeriesControl x:Name="AlternativeTimeSeriesSelector"
                            Grid.Column="0" HorizontalAlignment="Left" Margin="0,0,5,0"
                            Element="{Binding ElementName=TSControl, Path=Element}"
                            Visibility="{Binding ElementName=ShowAlternativesToggleButton, Path=IsChecked, Converter={StaticResource BoolToVisConverter}}"
                            TimeSeriesAdded="AlternativeTimeSeriesSelector_TimeSeriesAdded"
                            TimeSeriesRemoved="AlternativeTimeSeriesSelector_TimeSeriesRemoved"/>

                        <!--Time Series Plot Host-->
                        <ContentControl x:Name="TimeSeriesPlotHost" Grid.Column="1" Margin="6,2,0,0" />

                        <!--Plot Toolbar-->
                        <oxyCntrls:OxyPlotToolbar x:Name="PlotToolbar" Grid.Column="2" Margin="2" Background="Transparent" VerticalAlignment="Stretch" ToolBarOrientation="Vertical"/>
                    </Grid>
                </Grid>
            </Grid>
        </TabItem>
        <!-- Seasonality Plot Tab -->
        <TabItem x:Name="SeasonalityTab" Header="Seasonality Plot" Style="{DynamicResource VerticalTabItemStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="SeasonalityWarning" Grid.Row="0"
                           Text="The seasonality plot requires at least 2 years of data."
                           TextWrapping="Wrap" Foreground="#FFE41400" FontSize="13"
                           Margin="10,8,10,4" Visibility="Collapsed"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl x:Name="SeasonalityPlotHost" Grid.Column="0" Margin="6,2,0,0" />
                    <oxyCntrls:OxyPlotToolbar x:Name="SeasonalityPlotToolbar" Grid.Column="1" IconSize="20" Margin="0,2,2,0" Background="Transparent" VerticalAlignment="Stretch" ToolBarOrientation="Vertical"/>
                </Grid>
            </Grid>
        </TabItem>
        <!-- ACF Plot Tab -->
        <TabItem x:Name="ACFTab" Header="ACF Plot" Style="{DynamicResource VerticalTabItemStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="ACFMissingDataWarning" Grid.Row="0"
                           Text="The autocorrelation function (ACF) plot cannot be computed when there is missing data. Replace or interpolate missing data to update this plot."
                           TextWrapping="Wrap" Foreground="#FFE41400" FontSize="13"
                           Margin="10,8,10,4" Visibility="Collapsed"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl x:Name="ACFPlotHost" Grid.Column="0" />
                    <oxyCntrls:OxyPlotToolbar x:Name="ACFPlotToolbar" Grid.Column="1" IconSize="20" Margin="0,2,2,0" Background="Transparent" VerticalAlignment="Stretch" ToolBarOrientation="Vertical"/>
                </Grid>
            </Grid>
        </TabItem>
        <!-- PACF Plot Tab -->
        <TabItem x:Name="PACFTab" Header="PACF Plot" Style="{DynamicResource VerticalTabItemStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="PACFMissingDataWarning" Grid.Row="0"
                           Text="The partial autocorrelation function (PACF) plot cannot be computed when there is missing data. Replace or interpolate missing data to update this plot."
                           TextWrapping="Wrap" Foreground="#FFE41400" FontSize="13"
                           Margin="10,8,10,4" Visibility="Collapsed"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl x:Name="PACFPlotHost" Grid.Column="0" />
                    <oxyCntrls:OxyPlotToolbar x:Name="PACFPlotToolbar" Grid.Column="1" IconSize="20" Margin="0,2,2,0" Background="Transparent" VerticalAlignment="Stretch" ToolBarOrientation="Vertical"/>
                </Grid>
            </Grid>
        </TabItem>
        <!-- USGS Text File Tab (conditionally visible) -->
        <TabItem x:Name="USGSTextFileTab" Header="USGS Text File" Visibility="Collapsed" Style="{DynamicResource VerticalTabItemStyle}" >
            <RichTextBox x:Name="USGSRawTextBox" Margin="6" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
        </TabItem>
    </TabControl>
</UserControl>
