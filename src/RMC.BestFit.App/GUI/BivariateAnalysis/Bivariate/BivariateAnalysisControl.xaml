<UserControl  x:Class="RMC_BestFit.BivariateAnalysisControl" x:Name="BivariateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RMC_BestFit"
             xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:oxyCntrls="clr-namespace:OxyPlotControls;assembly=OxyPlotControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             PreviewMouseDown="UserControl_PreviewMouseDown"
             LostFocus="UserControl_LostFocus"
             Background="{DynamicResource EnvironmentWindowBackground}"
             Foreground="{DynamicResource EnvironmentWindowText}"
            >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <cntrls:DoubleToNAConverter x:Key="NAConverter"/>
                    <cntrls:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <TabControl Grid.Row="0" Margin="4" TabStripPlacement="Left" Background="Transparent">
            <TabItem x:Name="DistributionResultsTabItem" Header="Distribution Results" Style="{DynamicResource VerticalTabItemStyle}">
                <TabControl Grid.Row="0" Margin="4" TabStripPlacement="Top" Background="Transparent" SelectionChanged="InnerTabControl_SelectionChanged">
                    <TabItem x:Name="CopulaResultsTabItem"  Header="X-Y Plot" Style="{DynamicResource HorizontalTabItemStyle}" >
                        <ScrollViewer x:Name="Viewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Label Content="Axis Type" Margin="0" Grid.Row="0" Grid.Column="0"/>
                                <ComboBox Name="AxisTypeComboBox" Margin="4" Width="200" Grid.Row="1" Grid.Column="0" SelectedIndex="0" SelectionChanged="XParameterComboBox_SelectionChanged">
                                    <ComboBoxItem ToolTip="Plots the true marginal x and y values.">Value</ComboBoxItem>
                                    <ComboBoxItem ToolTip="Plots the CDF of the marginal x and y values.">Probability</ComboBoxItem>
                                </ComboBox>

                                <Label Content="Plot Type" Margin="0" Grid.Row="0" Grid.Column="1"/>
                                <ComboBox Name="PlotTypeComboBox" Margin="4" Width="200" Grid.Row="1" Grid.Column="1" SelectedIndex="0" SelectionChanged="YParameterComboBox_SelectionChanged">
                                    <ComboBoxItem ToolTip="Creates a scatter plot from 10,000 simulated points.">Scatter Plot</ComboBoxItem>
                                    <ComboBoxItem ToolTip="Creates a contour plot from the bivariate log densities.">Density Contour Plot</ComboBoxItem>
                                    <ComboBoxItem ToolTip="Creates a contour plot from the bivariate joint exceedance probabilities.">Probability Contour Plot</ComboBoxItem>
                                </ComboBox>

                                <Grid x:Name="PlotGrid"  Grid.Row="2" Grid.ColumnSpan="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!--Copula Plot-->
                                    <ContentControl x:Name="CopulaPlotHost" Grid.Column="0" Margin="2,2,0,0" />
                                    <!--Chronology Plot Toolbar-->
                                    <oxyCntrls:OxyPlotToolbar x:Name="CopulaPlotToolbar" Grid.Column="1" Background="Transparent" VerticalAlignment="Stretch" ToolBarOrientation="Vertical" PropertiesCalled="PlotToolbar_PropertiesCalled"/>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Tabular Results" Style="{DynamicResource HorizontalTabItemStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.75*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="0.25*" MinWidth="200" MaxWidth="500"/>
                            </Grid.ColumnDefinitions>

                            <cntrls:SeparatorWithHeader Header="Bivariate Frequency Results" Grid.Column="0" Grid.Row="0" Margin="5" />

                            <cntrls:CopyPasteDataGrid x:Name="FrequencyCurveTable" Grid.Column="0" Grid.Row="1" Margin="0,0,2,0"  Style="{DynamicResource CopyPasteDataGridStyle}"  
                                                    AutoGenerateColumns="False" SelectionMode="Extended" SelectionUnit="Cell" HeadersVisibility="Column" IsReadOnly="True"
                                                    CanUserAddInsertDeleteRows="False" CanUserDeleteRows="False" CanUserAddRows="False" CanUserResizeRows="False" 
                                                    CanUserResizeColumns="True" CanUserSortColumns="True" CanUserReorderColumns="False"  >

                                <cntrls:CopyPasteDataGrid.Columns>
                                    <DataGridTextColumn x:Name="XColumn" Header="X" IsReadOnly="True"  MinWidth="30"  Width="0.14286*"
                                                    Binding="{Binding Path=X}"
                                                    HeaderStyle="{DynamicResource Center_ColumnHeaderStyle}" 
                                                    CellStyle="{DynamicResource Right_CellStyle}" />
                                    <DataGridTextColumn x:Name="YColumn" Header="Y" IsReadOnly="True"  MinWidth="30"  Width="0.14286*"
                                                    Binding="{Binding Path=Y}"
                                                    HeaderStyle="{DynamicResource Center_ColumnHeaderStyle}" 
                                                    CellStyle="{DynamicResource Right_CellStyle}" />
                                    <DataGridTextColumn x:Name="UpperColumn" Header="Upper" IsReadOnly="True" MinWidth="30"  Width="0.14286*" 
                                                    Binding="{Binding Path=Upper}"
                                                    HeaderStyle="{DynamicResource Center_ColumnHeaderStyle}" 
                                                    CellStyle="{DynamicResource Right_CellStyle}"/>
                                    <DataGridTextColumn x:Name="LowerColumn" Header="Lower" IsReadOnly="True" MinWidth="30"  Width="0.14286*"
                                                    Binding="{Binding Path=Lower}"
                                                    HeaderStyle="{DynamicResource Center_ColumnHeaderStyle}" 
                                                    CellStyle="{DynamicResource Right_CellStyle}"/>
                                    <DataGridTextColumn x:Name="PredictiveColumn" Header="Posterior Predictive" IsReadOnly="True" MinWidth="30"  Width="0.14286*"
                                                    Binding="{Binding Path=Predictive}"
                                                    HeaderStyle="{DynamicResource Center_ColumnHeaderStyle}" 
                                                    CellStyle="{DynamicResource Right_CellStyle}"/>
                                    <DataGridTextColumn x:Name="ModeColumn" Header="Posterior Mode" IsReadOnly="True" MinWidth="30"  Width="0.14286*" 
                                                    Binding="{Binding Path=Mode}"
                                                    HeaderStyle="{DynamicResource Center_ColumnHeaderStyle}" 
                                                    CellStyle="{DynamicResource Right_CellStyle}"/>
                                </cntrls:CopyPasteDataGrid.Columns>
                            </cntrls:CopyPasteDataGrid>


                            <GridSplitter  Grid.Column="1" Grid.Row="1" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Transparent" Style="{DynamicResource VerticalGridSplitterStyle}"/>

                            <cntrls:SeparatorWithHeader Header="Summary Statistics" Grid.Column="2" Grid.Row="0" Margin="5"/>

                            <Grid Grid.Column="2" Grid.Row="1" Margin="2,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <cntrls:CopyPasteDataGrid Name="SummaryStatisticsTable" Grid.Row="0" Margin="4,0,0,0" HeadersVisibility="Column" Style="{DynamicResource CopyPasteDataGridStyle}"
                                                AutoGenerateColumns="False" SelectionMode="Extended" SelectionUnit="Cell" IsReadOnly="True" 
                                                CanUserDeleteRows="False" CanUserAddRows="False" CanUserResizeColumns="True" 
                                                CanUserResizeRows="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                                                LoadingRow="SummaryStatisticsTable_LoadingRow">

                                    <cntrls:CopyPasteDataGrid.Columns>
                                        <DataGridTextColumn x:Name="StatNameColumn" Header="Measure" IsReadOnly="True" MinWidth="50" Width="0.5*"
                                                        Binding="{Binding Path=Name}" 
                                                        HeaderStyle="{DynamicResource Left_ColumnHeaderStyle}"
                                                        CellStyle="{DynamicResource Left_CellStyle}"/>
                                        <DataGridTextColumn x:Name="StatValueColumn" Header="Posterior Mode" IsReadOnly="True"  MinWidth="50" Width="0.5*"
                                                        Binding="{Binding Path=Value, StringFormat='F4', FallbackValue=N/A, TargetNullValue=N/A, Converter={StaticResource NAConverter}}" 
                                                        HeaderStyle="{DynamicResource Center_ColumnHeaderStyle}"
                                                        CellStyle="{DynamicResource Right_CellStyle}"/>
                                    </cntrls:CopyPasteDataGrid.Columns>
                                </cntrls:CopyPasteDataGrid>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>
            <TabItem x:Name="ParameterSetsTabItem" Header="Parameter Sets" Style="{DynamicResource VerticalTabItemStyle}">
                <local:ParameterSetsControl x:Name ="ParameterSetsControl" Grid.Row="1" Analysis="{Binding ElementName=BivariateControl, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"/>
            </TabItem>
            <TabItem x:Name="InfluenceDiagnosticsTabItem" Header="Influence" Style="{DynamicResource VerticalTabItemStyle}">
                <local:InfluenceDiagnosticsControl x:Name="InfluenceDiagnosticsControl" Grid.Row="1"
                    Analysis="{Binding ElementName=BivariateControl, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                    PlotPropertiesCalled="PlotToolbar_PropertiesCalled"/>
            </TabItem>
            <TabItem x:Name="KernelDensityTabItem" Header="Kernel Density" Style="{DynamicResource VerticalTabItemStyle}">
                <local:KernelDensityControl x:Name ="KernelDensityControl" Grid.Row="1" Analysis="{Binding ElementName=BivariateControl, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                            PlotPropertiesCalled="PlotToolbar_PropertiesCalled"/>
            </TabItem>
            <TabItem x:Name="HistogramTabItem" Header="Histogram" Style="{DynamicResource VerticalTabItemStyle}">
                <local:HistogramControl x:Name ="HistogramControl" Grid.Row="1" Analysis="{Binding ElementName=BivariateControl, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                        PlotPropertiesCalled="PlotToolbar_PropertiesCalled"/>
            </TabItem>
            <TabItem x:Name="MeanLikelihoodTabItem" Header="Mean Likelihood" Style="{DynamicResource VerticalTabItemStyle}">
                <local:MeanLikelihoodControl x:Name ="MeanLikelihoodControl" Grid.Row="1" Analysis="{Binding ElementName=BivariateControl, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                             PlotPropertiesCalled="PlotToolbar_PropertiesCalled"/>
            </TabItem>
            <TabItem x:Name="AutocorrelationTabItem" Header="Autocorrelation" Style="{DynamicResource VerticalTabItemStyle}">
                <local:AutocorrelationControl x:Name ="AutocorrelationControl" Grid.Row="1" Analysis="{Binding ElementName=BivariateControl, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                              PlotPropertiesCalled="PlotToolbar_PropertiesCalled"/>
            </TabItem>
            <TabItem x:Name="MarkovChainTabItem" Header="Markov Chain Traces" Style="{DynamicResource VerticalTabItemStyle}">
                <local:MarkovChainTraceControl x:Name ="MarkovChainTraceControl" Grid.Row="1" Analysis="{Binding ElementName=BivariateControl, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                               PlotPropertiesCalled="PlotToolbar_PropertiesCalled"/>
            </TabItem>
            <TabItem x:Name="MCMCReportTabItem" Header="MCMC Report" Style="{DynamicResource VerticalTabItemStyle}">
                <local:MCMCReportControl x:Name="MCMCReportControl" Analysis="{Binding ElementName=BivariateControl, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
