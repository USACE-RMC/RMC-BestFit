<UserControl x:Class="RMC_BestFit.B17CAnalysisPropertiesControl" x:Name="B17CAnalysisProperties"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RMC_BestFit"
             xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
             xmlns:numcntrls="clr-namespace:NumericControls;assembly=NumericControls"
             mc:Ignorable="d" 
             MinWidth="100"
             MinHeight="100"
             d:DesignHeight="450" d:DesignWidth="800"
             KeyDown="AnalysisProperties_KeyDown"
             Background="{DynamicResource PropertyGrid.Content.Background}"
             Foreground="{DynamicResource EnvironmentWindowText}"
>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GenericControls;Component/Resources/ResourceDictionary.xaml"/>
                <ResourceDictionary>
                    <cntrls:DoubleToGridLengthConverter x:Key="ActualToLengthConverter" />
                    <cntrls:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
                    <cntrls:ReverseBooleanConverter x:Key="ReverseBoolConverter"/>
                    <cntrls:DoubleToNAConverter x:Key="NAConverter"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10000000*" MinHeight="200"/>
            <RowDefinition Height="*" MinHeight="1"/>
            <RowDefinition Height="Auto" MinHeight="50" MaxHeight="200" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="Viewer" Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="MainGrid" Width="{Binding ElementName=Viewer, Path=ViewportWidth}" MinWidth="200" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TabControl Background="Transparent" DockPanel.Dock="Top" BorderBrush="Transparent" BorderThickness="0" Padding="0" Margin="0,5,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                    <TabControl.Resources>
                        <Style TargetType="{x:Type TabPanel}">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                        </Style>
                    </TabControl.Resources>
                    <TabItem x:Name="General_TabItem" Header="General" Style="{StaticResource PropertiesTabItemStyle}" PreviewMouseLeftButtonDown="TabItem_PreviewMouseLeftButtonDown">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--Function Properties-->
                            <Expander x:Name="PropertiesExpander" Grid.Row="0" 
                            Margin="0,4,4,8" 
                            Header="BULLETIN 17C ANALYSIS PROPERTIES" 
                            IsExpanded="True" 
                            Style="{DynamicResource PropertyExpanderStyle}">
                                <DockPanel>

                                    <cntrls:NameTextPropertyControl x:Name="ElementName" Margin="0 2" CharacterLimit="50" DockPanel.Dock="Top" Title="Name" MaxPropertyWidth="200" 
                                                        Text="{Binding Element.Name, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" PreviewMouseLeftButtonDown="Name_PreviewMouseLeftButtonDown"
                                                        PropertyWidth="{Binding ElementName=LastModified, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"
                                                        GotFocus="Name_GotFocus" LostFocus="Name_LostFocus"/>

                                    <cntrls:ResizeableTextPropertyControl x:Name="Description" Margin="0 2" DockPanel.Dock="Top" Title="Description" MaxPropertyWidth="200" 
                                                                Text="{Binding Element.Description, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" PreviewMouseLeftButtonDown="Description_PreviewMouseLeftButtonDown"
                                                                PropertyWidth="{Binding ElementName=LastModified, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                                    <cntrls:TextPropertyControl x:Name="CreationDate" Margin="0 2" DockPanel.Dock="Top" Title="Created On" MaxPropertyWidth="200" IsReadOnly="True"
                                                    Text="{Binding Element.CreationDate, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" PreviewMouseLeftButtonDown="CreationDate_PreviewMouseLeftButtonDown"
                                                    PropertyWidth="{Binding ElementName=LastModified, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                                    <cntrls:TextPropertyControl x:Name="LastModified" Margin="0 2" DockPanel.Dock="Top" Title="Last Modified" MaxPropertyWidth="200" IsReadOnly="True" 
                                                    Text="{Binding Element.LastModified, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" PreviewMouseLeftButtonDown="LastModified_PreviewMouseLeftButtonDown"/>

                                    <!--Input Data-->
                                    <cntrls:ContentPropertyControl x:Name="InputDataComboBox" Margin="0 2" DockPanel.Dock="Top" Title="Input Data" MaxPropertyWidth="200"
                                                PreviewMouseLeftButtonDown="InputData_PreviewMouseLeftButtonDown" ToolTip="Please select a valid input data."
                                                PropertyWidth="{Binding ElementName=LastModified, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}">
                                        <cntrls:ContentPropertyControl.InnerContent>
                                            <Border BorderBrush="Red" BorderThickness="1" Visibility="Visible">
                                                <ComboBox HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Loaded="ComboBox_Loaded"
                                            SelectedValue="{Binding Element.InputData, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            DisplayMemberPath="Name" SelectionChanged="InputDataComboBox_SelectionChanged">
                                                </ComboBox>
                                            </Border>
                                        </cntrls:ContentPropertyControl.InnerContent>
                                    </cntrls:ContentPropertyControl>

                                    <!--Distribution-->
                                    <cntrls:ContentPropertyControl x:Name="Distribution" Margin="0 2" DockPanel.Dock="Top" Title="Distribution" MaxPropertyWidth="200"
                                        PreviewMouseLeftButtonDown="Distribution_PreviewMouseLeftButtonDown"
                                        PropertyWidth="{Binding ElementName=LastModified, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"  >
                                        <cntrls:ContentPropertyControl.InnerContent>
                                            <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            ItemsSource="{Binding DistributionList, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValue="{Binding Element.Bulletin17CDistribution.DistributionType, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                            SelectionChanged="DistributionComboBox_SelectionChanged"
                                            Loaded="DistributionComboBox_Loaded">
                                            </ComboBox>
                                        </cntrls:ContentPropertyControl.InnerContent>
                                    </cntrls:ContentPropertyControl>

                                </DockPanel>
                            </Expander>

                            <!--Parameter Priors-->
                            <Expander x:Name="ParameterPriorsExpander" Grid.Row="1" 
                            Margin="0,4,4,8" 
                            Header="PARAMETER INFORMATION" 
                            IsExpanded="True" 
                            Style="{DynamicResource PropertyExpanderStyle}">
                                <DockPanel >

                                    <!--Parameter Grid-->
                                    <cntrls:CopyPasteDataGrid x:Name="ParametersTable" Margin="0 2"
                                              DockPanel.Dock="Top"
                                              HeadersVisibility="Column"
                                              AutoGenerateColumns="False" 
                                              SelectionMode="Extended" 
                                              SelectionUnit="Cell" 
                                              CanUserDeleteRows="False" 
                                              CanUserAddRows="False" 
                                              CanUserResizeRows="False" 
                                              CanUserResizeColumns="False" 
                                              CanUserSortColumns="False" 
                                              CanUserReorderColumns="False" 
                                              CanUserAddInsertDeleteRows="False" 
                                              PasteAddsRows="False"
                                              PreviewMouseLeftButtonDown="ParametersTable_PreviewMouseLeftButtonDown"
                                              Style="{DynamicResource CopyPasteDataGridStyle}"
                                              ColumnHeaderStyle="{DynamicResource Center_ColumnHeaderStyle}">
                                        <cntrls:CopyPasteDataGrid.Columns>
                                            <DataGridTemplateColumn x:Name="EnabledColumn" IsReadOnly="False" Width="22" MinWidth="22" MaxWidth="22"
                                                            HeaderStyle="{DynamicResource Center_ColumnHeaderStyle}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding Path=Enabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn x:Name="NameColumn" IsReadOnly="True" Header="Parameter" Width="*" Binding="{Binding Path=Name}" 
                                                                HeaderStyle="{DynamicResource Left_ColumnHeaderStyle}">
                                                <DataGridTextColumn.CellStyle>
                                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource Left_CellStyle}">
                                                        <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                                        <Setter Property="IsEnabled" Value="True"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.CellStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn x:Name="MeanColumn"
                                                Header="Mean"
                                                Width="0.5*"
                                                Binding="{Binding Mean, FallbackValue=N/A, TargetNullValue=N/A, Converter={StaticResource NAConverter}}"
                                                HeaderStyle="{DynamicResource Center_ColumnHeaderStyle}">
                                                <DataGridTextColumn.CellStyle>
                                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource Right_CellStyle}">
                                                        <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                                                        <Setter Property="IsEnabled" Value="True"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Enabled}" Value="True"/>
                                                                    <Condition Binding="{Binding IsMeanValid}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Background"      Value="#FFF7B6AF"/>
                                                                <Setter Property="BorderBrush"     Value="Red"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Setter Property="ToolTip"         Value="{Binding MeanErrorMessage}"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.CellStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn x:Name="MSEColumn"
                                                Header="MSE"
                                                Width="0.5*"
                                                Binding="{Binding MSE, FallbackValue=N/A, TargetNullValue=N/A, Converter={StaticResource NAConverter}}"
                                                HeaderStyle="{DynamicResource Center_ColumnHeaderStyle}">
                                                <DataGridTextColumn.CellStyle>
                                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource Right_CellStyle}">
                                                        <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                                                        <Setter Property="IsEnabled" Value="True"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Enabled}" Value="True"/>
                                                                    <Condition Binding="{Binding IsMSEValid}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Background"      Value="#FFF7B6AF"/>
                                                                <Setter Property="BorderBrush"     Value="Red"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Setter Property="ToolTip"         Value="{Binding MSEErrorMessage}"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.CellStyle>
                                            </DataGridTextColumn>
                                        </cntrls:CopyPasteDataGrid.Columns>
                                    </cntrls:CopyPasteDataGrid>
                                    
                                </DockPanel>
                            </Expander>

                            <!--Quantile Priors-->
                            <Expander x:Name="QuantilePriorsExpander" Grid.Row="2" 
                            Margin="0,4,4,8" 
                            Header="QUANTILE INFORMATION" 
                            IsExpanded="True" 
                            Style="{DynamicResource PropertyExpanderStyle}">
                                <DockPanel >
                                    <!--Quantile Grid-->
                                    <cntrls:CopyPasteDataGrid x:Name="QuantileTable" Margin="0 2"
                                        DockPanel.Dock="Top"
                                        HeadersVisibility="Column"
                                        AutoGenerateColumns="False" 
                                        SelectionMode="Extended" 
                                        SelectionUnit="Cell" 
                                        CanUserDeleteRows="False" 
                                        CanUserAddRows="False" 
                                        CanUserResizeRows="False" 
                                        CanUserResizeColumns="False" 
                                        CanUserSortColumns="False" 
                                        CanUserReorderColumns="False" 
                                        CanUserAddInsertDeleteRows="False" 
                                        PasteAddsRows="False"
                                        PreviewMouseLeftButtonDown="QuantileTable_PreviewMouseLeftButtonDown"
                                        Style="{DynamicResource CopyPasteDataGridStyle}"
                                        ColumnHeaderStyle="{DynamicResource Center_ColumnHeaderStyle}">
                                        <cntrls:CopyPasteDataGrid.Columns>
                                            <DataGridTemplateColumn x:Name="QEnabledColumn" IsReadOnly="False" Width="22" MinWidth="22" MaxWidth="22"
                                                    HeaderStyle="{DynamicResource Center_ColumnHeaderStyle}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding Path=Enabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn x:Name="AEPColumn" Header="Probability" IsReadOnly="False" Width="*" HeaderStyle="{DynamicResource Left_ColumnHeaderStyle}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox x:Name="AEPComboBox" ItemsSource="{Binding ElementName=B17CAnalysisProperties, Path=AEPOptions}" SelectedValue="{Binding AEP, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellStyle>
                                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource Left_CellStyle}">
                                                        <Setter Property="IsEnabled" Value="True"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTemplateColumn.CellStyle>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn x:Name="UseLog10Column" IsReadOnly="False" Header="Log₁₀" Width="44" MinWidth="44" MaxWidth="44"
                                                    HeaderStyle="{DynamicResource Center_ColumnHeaderStyle}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding Path=UseLog10, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellStyle>
                                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource Center_CellStyle}">
                                                        <Setter Property="IsEnabled" Value="True"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTemplateColumn.CellStyle>
                                            </DataGridTemplateColumn>

                                            <DataGridTextColumn x:Name="QMeanColumn"
                                                 Header="Mean"
                                                 Width="0.5*"
                                                 Binding="{Binding Mean, FallbackValue=N/A, TargetNullValue=N/A, Converter={StaticResource NAConverter}}"
                                                 HeaderStyle="{DynamicResource Center_ColumnHeaderStyle}">
                                                <DataGridTextColumn.CellStyle>
                                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource Right_CellStyle}">
                                                        <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                                                        <Setter Property="IsEnabled" Value="True"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Enabled}" Value="True"/>
                                                                    <Condition Binding="{Binding IsMeanValid}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Background"      Value="#FFF7B6AF"/>
                                                                <Setter Property="BorderBrush"     Value="Red"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Setter Property="ToolTip"         Value="{Binding MeanErrorMessage}"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.CellStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn x:Name="QMSEColumn"
                                                 Header="MSE"
                                                 Width="0.5*"
                                                 Binding="{Binding MSE, FallbackValue=N/A, TargetNullValue=N/A, Converter={StaticResource NAConverter}}"
                                                 HeaderStyle="{DynamicResource Center_ColumnHeaderStyle}">
                                                <DataGridTextColumn.CellStyle>
                                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource Right_CellStyle}">
                                                        <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                                                        <Setter Property="IsEnabled" Value="True"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Enabled}" Value="True"/>
                                                                    <Condition Binding="{Binding IsMSEValid}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Background"      Value="#FFF7B6AF"/>
                                                                <Setter Property="BorderBrush"     Value="Red"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Setter Property="ToolTip"         Value="{Binding MSEErrorMessage}"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGridTextColumn.CellStyle>
                                            </DataGridTextColumn>
                                        </cntrls:CopyPasteDataGrid.Columns>
                                    </cntrls:CopyPasteDataGrid>
                                    
                                </DockPanel>
                            </Expander>

                            <!--Estimate Button-->
                            <Grid Grid.Row="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Value="0" Height="24" Margin="2,5,4,0" Grid.Column="0" Visibility="Hidden" Background="{DynamicResource ProgressBar.Static.Background}" Foreground="{DynamicResource ProgressBar.Static.Foreground}" BorderBrush="{DynamicResource ProgressBar.Static.Border}"/>
                                <TextBlock x:Name="ProgressTextBlock" Text="0%" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,5,4,0" Grid.Column="0" Visibility="Hidden" Foreground="{DynamicResource EnvironmentWindowText}"/>
                                <Button Name="EstimateButton" ToolTip="Click to run the analysis" Grid.Row="0" Grid.Column="1"  VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                                        Width="83" Height="24" Margin="0,5,5,0" Cursor="Hand" Click="EstimateButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Content="{DynamicResource RunIcon}" Margin="0,0,4,0"/>
                                        <TextBlock Text="Estimate" />
                                    </StackPanel>
                                </Button>
                                <Button Name="CancelButton" ToolTip="Click to cancel the analysis" Grid.Row="0" Grid.Column="1"  VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                                Visibility="Hidden" Width="83" Height="24" Margin="0,5,5,0" Cursor="Hand" Click="CancelButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Content="{DynamicResource StopIcon}" Margin="0,0,4,0"/>
                                        <TextBlock Text="Cancel" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                        </Grid>
                    </TabItem>
                    <TabItem x:Name="Options_TabItem" Header="Options" Style="{StaticResource PropertiesTabItemStyle}" PreviewMouseLeftButtonDown="TabItem_PreviewMouseLeftButtonDown">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Expander Grid.Row="0" 
                                Margin="0,4,4,8" 
                                Header="UNCERTAINTY OPTIONS" 
                                IsExpanded="True" 
                                Grid.ColumnSpan="2"
                                Style="{DynamicResource PropertyExpanderStyle}">
                                <DockPanel >

                                    <!--Uncertainty Method-->
                                    <cntrls:ContentPropertyControl x:Name="UncertaintyMethod" Margin="0 2" DockPanel.Dock="Top" Title="Uncertainty Method" MaxPropertyWidth="200"
                                                PreviewMouseLeftButtonDown="UncertaintyMethod_PreviewMouseLeftButtonDown">
                                        <cntrls:ContentPropertyControl.InnerContent>
                                            <ComboBox Grid.Column="2"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                            ItemsSource="{Binding UncertaintyMethodList}" 
                                            DisplayMemberPath="DisplayName"
                                            SelectedValuePath="Value"
                                            SelectedValue="{Binding Element.UncertaintyMethod, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                                <ComboBox.ItemContainerStyle>
                                                    <Style>
                                                        <Setter Property="Control.ToolTip" Value="{Binding ToolTip}" />
                                                    </Style>
                                                </ComboBox.ItemContainerStyle>
                                            </ComboBox>
                                        </cntrls:ContentPropertyControl.InnerContent>
                                    </cntrls:ContentPropertyControl>
                                    
                                    <!--PRNG Seed-->
                                    <cntrls:NumericPropertyControl x:Name="PRNGSeed" Margin="0 2" DockPanel.Dock="Top" Title="PRNG Seed"
                                           MaxPropertyWidth="200" PreviewMouseLeftButtonDown="PRNGSeed_PreviewMouseLeftButtonDown"
                                           CanHaveNegative="False"
                                           Number="{Binding Element.PRNGSeed, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                           PropertyWidth="{Binding ElementName=UncertaintyMethod, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/> 

                                </DockPanel>
                            </Expander>

                            <Expander Grid.Row="1" 
                                Margin="0,4,4,8" 
                                Header="OUTPUT OPTIONS"
                                IsExpanded="True" 
                                Grid.ColumnSpan="2"
                                Style="{DynamicResource PropertyExpanderStyle}">
                                <DockPanel >

                                    <!--Confidence Interval-->
                                    <cntrls:ContentPropertyControl x:Name="ConfidenceInterval" Margin="0 2" DockPanel.Dock="Top" Title="Confidence Interval" MaxPropertyWidth="200"
                                                        PropertyWidth="{Binding ElementName=UncertaintyMethod, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}" 
                                                        PreviewMouseLeftButtonDown="ConfidenceInterval_PreviewMouseLeftButtonDown">
                                        <cntrls:ContentPropertyControl.InnerContent>
                                            <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                ItemsSource="{Binding CredibleIntervalItems, UpdateSourceTrigger=PropertyChanged}"
                                                SelectedValue="{Binding Element.BayesianAnalysis.CredibleIntervalWidth, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                DisplayMemberPath="DisplayName" SelectedValuePath="Value">
                                            </ComboBox>
                                        </cntrls:ContentPropertyControl.InnerContent>
                                    </cntrls:ContentPropertyControl>

                                    <!--Output Length-->
                                    <cntrls:NumericPropertyControl x:Name="OutputLength" Margin="0 2" DockPanel.Dock="Top" Title="Output Length" MaxPropertyWidth="200" PreviewMouseLeftButtonDown="OutputLength_PreviewMouseLeftButtonDown"
                                                        CanHaveNegative="False" MinValue="100" MaxValue="1000000" Number="{Binding Element.BayesianAnalysis.OutputLength, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"                                                             
                                                        PropertyWidth="{Binding ElementName=UncertaintyMethod, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                                    <!--Point Estimator-->
                                    <cntrls:ContentPropertyControl x:Name="PointEstimator" Margin="0 2" DockPanel.Dock="Top" Title="Point Estimator" MaxPropertyWidth="200"
                                               PropertyWidth="{Binding ElementName=UncertaintyMethod, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"
                                               PreviewMouseLeftButtonDown="PointEstimator_PreviewMouseLeftButtonDown" >
                                        <cntrls:ContentPropertyControl.InnerContent>
                                            <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                ItemsSource="{Binding PointEstimatorItems, UpdateSourceTrigger=PropertyChanged}"
                                                SelectedValue="{Binding Element.BayesianAnalysis.PointEstimator, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                DisplayMemberPath="DisplayName" SelectedValuePath="Value">
                                            </ComboBox>
                                        </cntrls:ContentPropertyControl.InnerContent>
                                    </cntrls:ContentPropertyControl>

                                </DockPanel>
                            </Expander>

                            <!--Probability Ordinates-->
                            <Expander Grid.Row="2" 
                                Margin="0,4,4,8" 
                                Header="PROBABILITY ORDINATES" 
                                IsExpanded="True" 
                                Grid.ColumnSpan="2"
                                Style="{DynamicResource PropertyExpanderStyle}">
                                <DockPanel >
                                    <!--Probability Ordinates-->
                                    <numcntrls:ProbabilityOrdinatesControl ProbabilityOrdinates="{Binding ElementName=B17CAnalysisProperties, Path=Element.ProbabilityOrdinates, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" PreviewMouseLeftButtonDown="ProbabilityOrdinatesControl_PreviewMouseLeftButtonDown"/>
                                </DockPanel>
                            </Expander>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </ScrollViewer>
        <!--Property Attributes-->
        <GridSplitter Grid.Row="1" Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Background="{DynamicResource SeparatorBorder}"/>
        <cntrls:PropertyAttributes x:Name="PropertyAttributes" Grid.Row="2"/>
    </Grid>
</UserControl>

