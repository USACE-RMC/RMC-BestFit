<UserControl x:Class="RMC_BestFit.PointProcessAnalysisControl" x:Name="PointProcessControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RMC_BestFit"
             xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:oxyCntrls="clr-namespace:OxyPlotControls;assembly=OxyPlotControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             PreviewMouseDown="UserControl_PreviewMouseDown"
             LostFocus="UserControl_LostFocus"
             Background="{DynamicResource EnvironmentWindowBackground}"
             Foreground="{DynamicResource EnvironmentWindowText}"
            >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <cntrls:DoubleToNAConverter x:Key="NAConverter"/>
                    <cntrls:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <TabControl Grid.Row="0" Margin="4" TabStripPlacement="Left" Background="Transparent">
            <TabItem x:Name="DistributionResultsTabItem" Header="Distribution Results" Style="{DynamicResource VerticalTabItemStyle}">
                <TabControl Grid.Row="0" Margin="4" TabStripPlacement="Top" Background="Transparent">
                    <TabItem x:Name="FrequencyResultsTabItem" Header="Frequency Plot" IsSelected="True" Style="{DynamicResource HorizontalTabItemStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel 
                                    Orientation="Horizontal" 
                                    Grid.Row="0" 
                                    Margin="5,0,0,0"
                                    Height="22"
                                    VerticalAlignment="Center" 
                                    HorizontalAlignment="Left"
                                    ToolTip="Show options for viewing alternative results.">

                                <ToggleButton 
                                        x:Name="ShowFilterToggleButton" 
                                        SnapsToDevicePixels="True" 
                                        VerticalAlignment="Center" 
                                        HorizontalAlignment="Left"
                                        IsChecked="False"
                                        Style="{DynamicResource PlusMinusToggleStyle}"/>

                                <TextBlock Text="Alternative Results" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="{DynamicResource EnvironmentWindowText}" MouseLeftButtonUp="TextBlock_MouseLeftButtonUp"/>

                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1"  VerticalAlignment="Center" HorizontalAlignment="Left">
                                <CheckBox x:Name="POTCheckbox" Content="Show POT Data" Margin="15,0,0,0" VerticalAlignment="Center" IsChecked="True" Checked="POTCheckbox_Checked" Unchecked="POTCheckbox_Unchecked"/>
                                <CheckBox x:Name="SeasonalCheckbox" Content="Show Seasonal Distributions" Margin="15,0,0,0" VerticalAlignment="Center" IsChecked="True"
                                          Visibility="{Binding Path=Element.PointProcess.IsSeasonal, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" 
                                          Checked="POTCheckbox_Checked" Unchecked="POTCheckbox_Unchecked"/>
                            </StackPanel>


                            <Grid Grid.Row="1" Grid.ColumnSpan="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!--Alternatives-->
                                <local:AlternativeControl x:Name="AlternativeSelector"
                                                            Grid.Column="0"
                                                            HorizontalAlignment="Left"
                                                            Margin="0,0,5,0"
                                                            Element="{Binding ElementName=PointProcessControl, Path=Element}"
                                                            Visibility="{Binding ElementName=ShowFilterToggleButton, Path=IsChecked, Converter={StaticResource BoolToVisConverter}}"                                                                        
                                                            AnalysisAdded="AlternativeSelector_AnalysisAdded" AnalysisRemoved="AlternativeSelector_AnalysisRemoved"/>

                                <!--Frequency Plot-->
                                <ContentControl x:Name="FrequencyPlotHost" Grid.Column="1" Margin="2,2,0,0" />

                                <!--Plot Toolbar-->
                                <oxyCntrls:OxyPlotToolbar x:Name="FrequencyPlotToolbar" Grid.Row="0" Grid.Column="2" Background="Transparent" VerticalAlignment="Stretch" ToolBarOrientation="Vertical" PropertiesCalled="PlotToolbar_PropertiesCalled" />
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Tabular Results" Style="{DynamicResource HorizontalTabItemStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.75*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="0.25*" MinWidth="200" MaxWidth="500"/>
                            </Grid.ColumnDefinitions>

                            <cntrls:SeparatorWithHeader Header="Frequency Curve Results" Grid.Column="0" Grid.Row="0" Margin="5" />

                            <cntrls:CopyPasteDataGrid x:Name="FrequencyCurveTable" Grid.Column="0" Grid.Row="1" Margin="0,0,2,0"  Style="{DynamicResource CopyPasteDataGridStyle}"  
                                                    AutoGenerateColumns="False" SelectionMode="Extended" SelectionUnit="Cell" HeadersVisibility="Column" IsReadOnly="True"
                                                    CanUserAddInsertDeleteRows="False" CanUserDeleteRows="False" CanUserAddRows="False" CanUserResizeRows="False" 
                                                    CanUserResizeColumns="True" CanUserSortColumns="True" CanUserReorderColumns="False"  >

                                <cntrls:CopyPasteDataGrid.Columns>
                                    <DataGridTextColumn x:Name="AEPColumn" Header="Probability" IsReadOnly="True"  MinWidth="30"  Width="0.14286*"
                                                    Binding="{Binding Path=Probability}"
                                                    HeaderStyle="{DynamicResource Center_ColumnHeaderStyle}" 
                                                    CellStyle="{DynamicResource Right_CellStyle}" />
                                    <DataGridTextColumn x:Name="UpperColumn" Header="Upper" IsReadOnly="True" MinWidth="30"  Width="0.14286*" 
                                                    Binding="{Binding Path=Upper}"
                                                    HeaderStyle="{DynamicResource Center_ColumnHeaderStyle}" 
                                                    CellStyle="{DynamicResource Right_CellStyle}"/>
                                    <DataGridTextColumn x:Name="LowerColumn" Header="Lower" IsReadOnly="True" MinWidth="30"  Width="0.14286*"
                                                    Binding="{Binding Path=Lower}"
                                                    HeaderStyle="{DynamicResource Center_ColumnHeaderStyle}" 
                                                    CellStyle="{DynamicResource Right_CellStyle}"/>
                                    <DataGridTextColumn x:Name="PredictiveColumn" Header="Posterior Predictive" IsReadOnly="True" MinWidth="30"  Width="0.14286*"
                                                    Binding="{Binding Path=Predictive}"
                                                    HeaderStyle="{DynamicResource Center_ColumnHeaderStyle}" 
                                                    CellStyle="{DynamicResource Right_CellStyle}"/>
                                    <DataGridTextColumn x:Name="ModeColumn" Header="Posterior Mode" IsReadOnly="True" MinWidth="30"  Width="0.14286*" 
                                                    Binding="{Binding Path=Mode}"
                                                    HeaderStyle="{DynamicResource Center_ColumnHeaderStyle}" 
                                                    CellStyle="{DynamicResource Right_CellStyle}"/>
                                </cntrls:CopyPasteDataGrid.Columns>
                            </cntrls:CopyPasteDataGrid>


                            <GridSplitter  Grid.Column="1" Grid.Row="1" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Transparent" Style="{DynamicResource VerticalGridSplitterStyle}"/>

                            <cntrls:SeparatorWithHeader Header="Summary Statistics" Grid.Column="2" Grid.Row="0" Margin="5"/>

                            <Grid Grid.Column="2" Grid.Row="1" Margin="2,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <cntrls:CopyPasteDataGrid Name="SummaryStatisticsTable" Grid.Row="0" Margin="4,0,0,0" HeadersVisibility="Column" Style="{DynamicResource CopyPasteDataGridStyle}"
                                                AutoGenerateColumns="False" SelectionMode="Extended" SelectionUnit="Cell" IsReadOnly="True" 
                                                CanUserDeleteRows="False" CanUserAddRows="False" CanUserResizeColumns="True" 
                                                CanUserResizeRows="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                                                LoadingRow="SummaryStatisticsTable_LoadingRow">

                                    <cntrls:CopyPasteDataGrid.Columns>
                                        <DataGridTextColumn x:Name="StatNameColumn" Header="Measure" IsReadOnly="True" MinWidth="50" Width="0.5*"
                                                        Binding="{Binding Path=Name}" 
                                                        HeaderStyle="{DynamicResource Left_ColumnHeaderStyle}"
                                                        CellStyle="{DynamicResource Left_CellStyle}"/>
                                        <DataGridTextColumn x:Name="StatValueColumn" Header="Posterior Mode" IsReadOnly="True"  MinWidth="50" Width="0.5*"
                                                        Binding="{Binding Path=Value, StringFormat='F4', FallbackValue=N/A, TargetNullValue=N/A, Converter={StaticResource NAConverter}}" 
                                                        HeaderStyle="{DynamicResource Center_ColumnHeaderStyle}"
                                                        CellStyle="{DynamicResource Right_CellStyle}"/>
                                    </cntrls:CopyPasteDataGrid.Columns>
                                </cntrls:CopyPasteDataGrid>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>
            <TabItem x:Name="ParameterSetsTabItem" Header="Parameter Sets" Style="{DynamicResource VerticalTabItemStyle}">
                <local:ParameterSetsControl x:Name ="ParameterSetsControl" Grid.Row="1" Analysis="{Binding ElementName=PointProcessControl, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"/>
            </TabItem>
            <TabItem x:Name="InfluenceDiagnosticsTabItem" Header="Influence" Style="{DynamicResource VerticalTabItemStyle}">
                <local:InfluenceDiagnosticsControl x:Name="InfluenceDiagnosticsControl" Grid.Row="1"
                    Analysis="{Binding ElementName=PointProcessControl, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                    PlotPropertiesCalled="PlotToolbar_PropertiesCalled"/>
            </TabItem>
            <TabItem x:Name="KernelDensityTabItem" Header="Kernel Density" Style="{DynamicResource VerticalTabItemStyle}">
                <local:KernelDensityControl x:Name ="KernelDensityControl" Grid.Row="1" Analysis="{Binding ElementName=PointProcessControl, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                            PlotPropertiesCalled="PlotToolbar_PropertiesCalled"/>
            </TabItem>
            <TabItem x:Name="HistogramTabItem" Header="Histogram" Style="{DynamicResource VerticalTabItemStyle}">
                <local:HistogramControl x:Name ="HistogramControl" Grid.Row="1" Analysis="{Binding ElementName=PointProcessControl, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                        PlotPropertiesCalled="PlotToolbar_PropertiesCalled"/>
            </TabItem>
            <TabItem x:Name="BivariateTabItem" Header="Bivariate" Style="{DynamicResource VerticalTabItemStyle}">
                <local:BivariateHeatMapControl x:Name ="BivariateHeatMapControl" Grid.Row="1" Analysis="{Binding ElementName=PointProcessControl, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                               PlotPropertiesCalled="PlotToolbar_PropertiesCalled"/>
            </TabItem>
            <TabItem x:Name="MeanLikelihoodTabItem" Header="Mean Likelihood" Style="{DynamicResource VerticalTabItemStyle}">
                <local:MeanLikelihoodControl x:Name ="MeanLikelihoodControl" Grid.Row="1" Analysis="{Binding ElementName=PointProcessControl, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                             PlotPropertiesCalled="PlotToolbar_PropertiesCalled"/>
            </TabItem>
            <TabItem x:Name="AutocorrelationTabItem" Header="Autocorrelation" Style="{DynamicResource VerticalTabItemStyle}">
                <local:AutocorrelationControl x:Name ="AutocorrelationControl" Grid.Row="1" Analysis="{Binding ElementName=PointProcessControl, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                              PlotPropertiesCalled="PlotToolbar_PropertiesCalled"/>
            </TabItem>
            <TabItem x:Name="MarkovChainTabItem" Header="Markov Chain Traces" Style="{DynamicResource VerticalTabItemStyle}">
                <local:MarkovChainTraceControl x:Name ="MarkovChainTraceControl" Grid.Row="1" Analysis="{Binding ElementName=PointProcessControl, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                               PlotPropertiesCalled="PlotToolbar_PropertiesCalled"/>
            </TabItem>
            <TabItem x:Name="MCMCReportTabItem" Header="MCMC Report" Style="{DynamicResource VerticalTabItemStyle}">
                <local:MCMCReportControl x:Name="MCMCReportControl" Analysis="{Binding ElementName=PointProcessControl, Path=Element.BayesianAnalysis, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
