<UserControl x:Class="RMC_BestFit.BivariateHeatMapControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RMC_BestFit"
             xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:oxyCntrls="clr-namespace:OxyPlotControls;assembly=OxyPlotControls"
             mc:Ignorable="d" 
             d:DesignHeight="600" 
             d:DesignWidth="1000" 
             Loaded="UserControl_Loaded"
             PreviewMouseDown="UserControl_PreviewMouseDown"
             LostFocus="UserControl_LostFocus"
             Background="{DynamicResource EnvironmentWindowBackground}"
             Foreground="{DynamicResource EnvironmentWindowText}"
             DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <ScrollViewer x:Name="Viewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Content="Select X Parameter" Margin="0" Grid.Row="0" Grid.Column="0"/>
            <ComboBox Name="XParameterComboBox" Margin="4" Width="200" Grid.Row="1" Grid.Column="0" SelectionChanged="XParameterComboBox_SelectionChanged"/>

            <Label Content="Select Y Parameter" Margin="0" Grid.Row="0" Grid.Column="1"/>
            <ComboBox Name="YParameterComboBox" Margin="4" Width="200" Grid.Row="1" Grid.Column="1" SelectionChanged="YParameterComboBox_SelectionChanged"/>

            <Grid x:Name="PlotGrid"  Grid.Row="2" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!--Plot-->
                <ContentControl x:Name="PlotHost" Grid.Column="0" Margin="2,2,0,0" />
                <!-- Plot Toolbar-->
                <oxyCntrls:OxyPlotToolbar x:Name="PlotToolbar" Grid.Row="0" Grid.Column="1" Background="Transparent" VerticalAlignment="Stretch" ToolBarOrientation="Vertical" PropertiesCalled="PlotToolbar_PropertiesCalled"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
