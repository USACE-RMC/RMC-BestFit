<UserControl x:Class="RMC_BestFit.ParameterSetsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RMC_BestFit"
             xmlns:tblView="clr-namespace:DatabaseControls;assembly=DatabaseControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="UserControl_Loaded"
             Background="{DynamicResource EnvironmentWindowBackground}"
             Foreground="{DynamicResource EnvironmentWindowText}"
             DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Grid>
        <tblView:TableViewer
                    x:Name="ParameterSetTableViewer" 
                    RowSelectable="True" 
                    ColumnSelectable="True" 
                    CellSelectable="True" 
                    ShowRowHeaders="False"
                    AutoFitColumns="True"/>
    </Grid>
</UserControl>
