<cntrls:MetroWindow x:Class="RMC_BestFit.BatchRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RMC_BestFit"
        xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
        mc:Ignorable="d"
        Title="Batch Run"
        Icon="{DynamicResource BatchRunIcon}"
        KeyDown="BatchRun_KeyDown"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        Style="{DynamicResource MetroWindowStyle}"
        Background="{DynamicResource EnvironmentWindowBackground}"
        Foreground="{DynamicResource EnvironmentWindowText}"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <cntrls:MetroWindow.Resources>
        <ResourceDictionary>
            <local:BatchRunStatusToIconConverter x:Key="StatusToIconConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        </ResourceDictionary>
    </cntrls:MetroWindow.Resources>
    <Grid x:Name="MainGrid">

        <!--Add Rows-->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--Add Columns-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--Data Grid-->
        <DataGrid x:Name="MyDataGrid" Grid.Column="0" Margin="6" Height="300" Width="550" AutoGenerateColumns="False" IsReadOnly="True" Background="{DynamicResource EnvironmentWindowBackground}" BorderBrush="{DynamicResource SeparatorBorder}" BorderThickness="1"
                  GridLinesVisibility="None" HeadersVisibility="Column" SelectionChanged="MyDataGrid_SelectionChanged" >
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <!-- Element type icon -->
                <DataGridTemplateColumn HeaderStyle="{DynamicResource Center_ColumnHeaderStyle_Modal}" Width="SizeToCells" CanUserSort="False" CanUserReorder="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding ElementImage}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Analysis name -->
                <DataGridTextColumn HeaderStyle="{DynamicResource Left_ColumnHeaderStyle_Modal}" MinWidth="150" Width="*" Header="Name" Binding="{Binding DisplayName}" CanUserSort="True" CanUserReorder="False"/>
                <!-- Per-row progress bar with text overlay (visible only when running) -->
                <DataGridTemplateColumn HeaderStyle="{DynamicResource Center_ColumnHeaderStyle_Modal}" Header="Progress" Width="120" CanUserSort="False" CanUserReorder="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}" Height="16" Margin="2"
                                             Background="{DynamicResource ProgressBar.Static.Background}" Foreground="{DynamicResource ProgressBar.Static.Foreground}" BorderBrush="{DynamicResource ProgressBar.Static.Border}">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static local:BatchRunStatus.Pending}">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static local:BatchRunStatus.Running}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static local:BatchRunStatus.Succeeded}">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static local:BatchRunStatus.Failed}">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static local:BatchRunStatus.Canceled}">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                                <TextBlock Text="{Binding ProgressText}" FontSize="10"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static local:BatchRunStatus.Pending}">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static local:BatchRunStatus.Running}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static local:BatchRunStatus.Succeeded}">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static local:BatchRunStatus.Failed}">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static local:BatchRunStatus.Canceled}">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Duration column -->
                <DataGridTextColumn HeaderStyle="{DynamicResource Center_ColumnHeaderStyle_Modal}" Header="Duration" Width="75" Binding="{Binding DurationText}" SortMemberPath="Duration" CanUserSort="True" CanUserReorder="False" CanUserResize="False">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{DynamicResource EnvironmentWindowText}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <!-- Status icon column -->
                <DataGridTemplateColumn HeaderStyle="{DynamicResource Center_ColumnHeaderStyle_Modal}" Header="Status" Width="50" SortMemberPath="Status" CanUserSort="True" CanUserReorder="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Width="16" Height="16" Source="{Binding Status, Converter={StaticResource StatusToIconConverter}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Style.Triggers>
                                            <!-- Rotate animation when running -->
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static local:BatchRunStatus.Running}">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="SpinStoryboard">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0" To="360" Duration="0:0:1.5" RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="SpinStoryboard"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                                <Image.RenderTransformOrigin>
                                    <Point X="0.5" Y="0.5"/>
                                </Image.RenderTransformOrigin>
                                <Image.RenderTransform>
                                    <RotateTransform/>
                                </Image.RenderTransform>
                            </Image>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!--Document Buttons-->
        <Grid x:Name="DocumentButtonGrid" Grid.Row="0" Grid.Column="1">
            <!--Add Rows-->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button Name="SelectButton" Height="24" Width="110" IsEnabled="True" Click="SelectButton_Click" Content="Select All" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="0" Margin="0,6,6,6" Cursor="Hand"/>
            <Button Name="DeselectButton"  Height="24" Width="110" IsEnabled="False"  Click="DeselectButton_Click" Content="Deselect All" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="1" Margin="0,0,6,6" Cursor="Hand"/>
            <Button Name="SimulateButton" Height="24" Width="110" IsEnabled="False" Click="SimulateButton_Click" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="2" Margin="0,0,6,6" Cursor="Hand" >
                <StackPanel Orientation="Horizontal">
                    <ContentControl Content="{DynamicResource RunIcon}" Margin="0,0,4,0"/>
                    <TextBlock Text="Estimate" />
                </StackPanel>
            </Button>
            <Button Name="CancelButton" Height="24" Width="110" Click="CancelButton_Click" Visibility="Hidden" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="2" Margin="0,0,6,6" Cursor="Hand" >
                <StackPanel Orientation="Horizontal">
                    <ContentControl Content="{DynamicResource StopIcon}" Margin="0,0,4,0"/>
                    <TextBlock Text="Cancel" />
                </StackPanel>
            </Button>
            <CheckBox x:Name="ParallelCheckBox" Grid.Row="3" Content="Run in Parallel" IsChecked="True" Margin="4,0,6,0"
                      Foreground="{DynamicResource EnvironmentWindowText}" Cursor="Hand"/>
        </Grid>

        <!-- Summary status bar -->
        <TextBlock x:Name="SummaryTextBlock" Grid.Row="1" Grid.ColumnSpan="2"
                   Text="Select analyses and click Estimate to begin."
                   Foreground="{DynamicResource EnvironmentWindowText}"
                   TextTrimming="CharacterEllipsis"
                   Height="22" Padding="6,3" Margin="6,0,6,6"/>

    </Grid>
</cntrls:MetroWindow>
