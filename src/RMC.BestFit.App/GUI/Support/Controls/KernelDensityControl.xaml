<UserControl x:Class="RMC_BestFit.KernelDensityControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RMC_BestFit"
             xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:oxyCntrls="clr-namespace:OxyPlotControls;assembly=OxyPlotControls"
             mc:Ignorable="d" 
             d:DesignHeight="600" 
             d:DesignWidth="1000" 
             Loaded="UserControl_Loaded"
             PreviewMouseDown="UserControl_PreviewMouseDown"
             LostFocus="UserControl_LostFocus"
             Background="{DynamicResource EnvironmentWindowBackground}"
             Foreground="{DynamicResource EnvironmentWindowText}"
             DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <UserControl.Resources>
        <Style x:Key="KDEDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="{DynamicResource EnvironmentWindowBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource MessageWindow.Foreground}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Bottom"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MessageWindow.Gridlines}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MessageWindow.HeaderHoveredBackground}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MessageWindow.HeaderHoveredBackground}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="KDECellStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource Center_CellStyle}">
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Bottom" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <cntrls:DoubleToNAConverter x:Key="NAConverter"/>
    </UserControl.Resources>
    <ScrollViewer x:Name="Viewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Content="Select Parameter" Margin="0" Grid.Row="0" Grid.Column="0" ToolTip="Select a model parameter."/>
            <ComboBox Name="ParameterComboBox" Margin="4"  Width="200" Grid.Row="1" Grid.Column="0" SelectionChanged="ParameterComboBox_SelectionChanged"/>
            <CheckBox x:Name="ShowPriorDistribution" Content="Show Prior" IsChecked="False" VerticalAlignment="Center" Margin="4" Grid.Row="1" Grid.Column="1" Checked="ShowPriorDistribution_Checked" Unchecked="ShowPriorDistribution_Unchecked"/>


            <!--Plot-->
            <Grid Grid.Row="2" Grid.ColumnSpan="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!--Plot-->
                <ContentControl x:Name="PlotHost" Grid.Row="0" Grid.Column="0" Margin="2,2,0,0" />
                <!-- Plot Toolbar-->
                <oxyCntrls:OxyPlotToolbar x:Name="PlotToolbar" Grid.Row="0" Grid.Column="1" Background="Transparent" VerticalAlignment="Stretch" ToolBarOrientation="Vertical" PropertiesCalled="PlotToolbar_PropertiesCalled" />
            </Grid>

            <Expander Header="Summary Statistics" IsExpanded="True" Grid.Row="3" Grid.ColumnSpan="4" Foreground="{DynamicResource EnvironmentWindowText}" Style="{DynamicResource PropertyExpanderStyle}">
                <!--Summary Stats-->
                <cntrls:CopyPasteDataGrid x:Name="KDEDataGrid"  HorizontalAlignment="Left" Width="500" Background="{DynamicResource EnvironmentWindowBackground}" BorderBrush="Transparent" BorderThickness="1" GridLinesVisibility="None"
                                                  AutoGenerateColumns="False" SelectionMode="Extended" SelectionUnit="Cell" HeadersVisibility="Column" RowHeight="22" RowBackground="Transparent"
                                                  CanUserAddInsertDeleteRows="False" CanUserDeleteRows="False" CanUserAddRows="False" CanUserResizeRows="False" 
                                                  CanUserResizeColumns="False" CanUserSortColumns="False" CanUserReorderColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <!--Gelman-Rubin-->
                        <DataGridTextColumn x:Name="GelmanRubinColumn" Width="0.14*" Header="Rhat" HeaderStyle="{StaticResource KDEDataGridHeaderStyle}" CellStyle="{StaticResource KDECellStyle}"
                                                Binding="{Binding Rhat, StringFormat='F3', FallbackValue=N/A, TargetNullValue=N/A, Converter={StaticResource NAConverter}}" />
                        <!--ESS-->
                        <DataGridTextColumn x:Name="ESSColumn" Width="0.14*" MinWidth="30" Header="ESS"  HeaderStyle="{StaticResource KDEDataGridHeaderStyle}" CellStyle="{StaticResource KDECellStyle}"
                                                Binding="{Binding ESS, StringFormat='N0', FallbackValue=N/A, TargetNullValue=N/A, Converter={StaticResource NAConverter}}" />
                        <!--Mean-->
                        <DataGridTextColumn x:Name="MeanColumn" Width="0.16*" MinWidth="30" Header="Mean" HeaderStyle="{StaticResource KDEDataGridHeaderStyle}" CellStyle="{StaticResource KDECellStyle}"
                                                Binding="{Binding Mean, StringFormat='N4', FallbackValue=N/A, TargetNullValue=N/A, Converter={StaticResource NAConverter}}" />
                        <!--Standard Deviation-->
                        <DataGridTextColumn x:Name="StdDevColumn" Width="0.14*" MinWidth="30" Header="Std Dev" HeaderStyle="{StaticResource KDEDataGridHeaderStyle}" CellStyle="{StaticResource KDECellStyle}"
                                                Binding="{Binding StandardDeviation, StringFormat='N4', FallbackValue=N/A, TargetNullValue=N/A, Converter={StaticResource NAConverter}}" />
                        <!--Percentile 1-->
                        <DataGridTextColumn x:Name="Percentile1Column" Width="0.14*" Header="5%" HeaderStyle="{StaticResource KDEDataGridHeaderStyle}" CellStyle="{StaticResource KDECellStyle}"
                                                Binding="{Binding LowerCI, StringFormat='N4', FallbackValue=N/A, TargetNullValue=N/A, Converter={StaticResource NAConverter}}" />
                        <!--Percentile 2-->
                        <DataGridTextColumn x:Name="Percentile2Column" Width="0.14*" Header="50%" HeaderStyle="{StaticResource KDEDataGridHeaderStyle}" CellStyle="{StaticResource KDECellStyle}"
                                                Binding="{Binding Median, StringFormat='N4', FallbackValue=N/A, TargetNullValue=N/A, Converter={StaticResource NAConverter}}" />
                        <!--Percentile 3-->
                        <DataGridTextColumn x:Name="Percentile3Column" Width="0.14*" Header="95%" HeaderStyle="{StaticResource KDEDataGridHeaderStyle}" CellStyle="{StaticResource KDECellStyle}"
                                                Binding="{Binding UpperCI, StringFormat='N4', FallbackValue=N/A, TargetNullValue=N/A, Converter={StaticResource NAConverter}}" />
                    </DataGrid.Columns>

                </cntrls:CopyPasteDataGrid>

            </Expander>
        </Grid>
    </ScrollViewer>
</UserControl>
