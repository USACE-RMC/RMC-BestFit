{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EnableSwagger": false,
  "Api": {
    "MaxResources": 500,
    "MaxConcurrentRuns": 2,
    "MaxIterations": 500000
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost" ]
  }
}
