<Project Sdk="MSTest.Sdk/3.6.4">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyTitle>RMC.BestFit.Tests</AssemblyTitle>
    <Description>Unit tests for the Bayesian estimation and fitting software (RMC-BestFit).</Description>
    <Company>U.S. Army Corps of Engineers</Company>
    <Product>RMC-BestFit</Product>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <!--
      Displays error on console in addition to the log file. Note that this feature comes with a performance impact.
      For more information, visit https://learn.microsoft.com/dotnet/core/testing/unit-testing-platform-integration-dotnet-test#show-failure-per-test
      -->
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
  </PropertyGroup>
  
  <!-- Otherwise targets C# 7.3 which doesn't have global usings and some other syntactic sugar utilized here.  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net481'">
	  <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Link shared MSTest parallelization settings from the Verification project.
         Applies [assembly: Parallelize(...)] to this assembly too. -->
    <Compile Include="..\RMC.BestFit.Verification\MSTestSettings.cs" Link="MSTestSettings.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RMC.BestFit\RMC.BestFit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Numerics">
      <HintPath>..\..\..\numerics\Numerics\bin\Debug\net10.0\Numerics.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
